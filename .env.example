# Configuracao local - Docker Compose
POSTGRES_USER=store
POSTGRES_PASSWORD=store_local_password
POSTGRES_DB=store

# Para rodar a API fora do Docker (no host):
DATABASE_URL=postgresql://store:store_local_password@localhost:5432/store?schema=public

# Placeholders de teste. Use chaves reais SOMENTE no seu .env local.
STRIPE_KEY=sk_test_sua_chave_de_teste
STRIPE_WEBHOOK_SECRET_KEY=whsec_seu_webhook_de_teste

BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
PORT=4000
